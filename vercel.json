{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/:path((?!images/|video/|favicon|api/).+)", "destination": "/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(images|video)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
